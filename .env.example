# Swarnkar Jewellery ERP - Environment Variables Example
# Copy this file to .env.local for local development or configure these variables in Vercel Project Settings.
# NOTE: Do NOT place real secrets in VITE_* variables as VITE_* variables are public and bundled into client code.

# Firebase Web API Key (found in Firebase Console > Project Settings > General)
VITE_FIREBASE_API_KEY=

# Firebase Auth Domain (e.g. your-project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=

# Firebase Google Cloud Project ID (e.g. gen-lang-client-0664621053)
VITE_FIREBASE_PROJECT_ID=

# Firebase Storage Bucket URL (e.g. your-project-id.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=

# Firebase Cloud Messaging Sender ID (numerical ID)
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Firebase Web Application ID (1:xxxxxxx:web:xxxxxxx)
VITE_FIREBASE_APP_ID=

# Firestore Custom Database ID (e.g. ai-studio-shreemmehaljewel-... or leave empty for "(default)")
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
