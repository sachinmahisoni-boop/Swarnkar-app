rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unmanaged paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isFirmOwner(firmData) {
      return isSignedIn() && firmData.ownerUid == request.auth.uid;
    }

    function isFirmMember(firmData) {
      return isSignedIn() && (
        firmData.ownerUid == request.auth.uid ||
        ('staff' in firmData && request.auth.uid in firmData.staff)
      );
    }

    function isCashierRole(firmData) {
      return isFirmMember(firmData) && 
        ('staff' in firmData) && 
        firmData.staff[request.auth.uid] == 'cashier';
    }

    // Firm Root Collection
    match /firms/{firmId} {
      // Firm Document
      allow read: if isSignedIn() && isFirmMember(resource.data);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        isFirmOwner(resource.data) || (
          isFirmMember(resource.data) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerUid', 'staff'])
        )
      );
      allow delete: if isSignedIn() && isFirmOwner(resource.data);

      // Isolated Firm Subcollections
      match /{collectionName}/{docId} {
        allow read: if isSignedIn() && isFirmMember(get(/databases/$(database)/documents/firms/$(firmId)).data);
        
        // Disallow hard deletion of GST Invoices and Purchase Invoices - must be Cancelled instead
        allow delete: if isSignedIn() && 
          isFirmMember(get(/databases/$(database)/documents/firms/$(firmId)).data) &&
          collectionName != 'invoices' && 
          collectionName != 'purchases';

        allow create: if isSignedIn() && 
          isFirmMember(get(/databases/$(database)/documents/firms/$(firmId)).data) && (
            !isCashierRole(get(/databases/$(database)/documents/firms/$(firmId)).data) || (
              collectionName != 'rates' &&
              collectionName != 'shop_details' &&
              collectionName != 'sequence_counters'
            )
          ) && (
            collectionName != 'sequence_counters' || request.resource.data.currentVal == 1
          );

        allow update: if isSignedIn() && 
          isFirmMember(get(/databases/$(database)/documents/firms/$(firmId)).data) && (
            !isCashierRole(get(/databases/$(database)/documents/firms/$(firmId)).data) || (
              collectionName != 'rates' &&
              collectionName != 'shop_details' &&
              collectionName != 'sequence_counters' && (
                collectionName != 'invoices' ||
                request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'status', 'cancelReason', 'cancelledBy', 'cancelledAt', 'payment', 'paidAmount', 'dueAmount'
                ])
              )
            )
          ) && (
            collectionName != 'sequence_counters' || request.resource.data.currentVal == resource.data.currentVal + 1
          );
      }
    }
  }
}
