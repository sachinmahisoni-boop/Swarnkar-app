rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    match /firms/{firmId} {
      allow read, write: if request.auth != null;
      match /invoices/{invoiceId} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
